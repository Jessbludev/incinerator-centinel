[Unit]
Description=Incinerator Sentinel
After=network-pre.target
Wants=network-pre.target
Documentation=man:incinerator-sentinel(1)

[Service]
Type=notify
ExecStart=/usr/local/bin/incinerator-sentinel serve --config /etc/incinerator-sentinel/config.toml --policy /etc/incinerator-sentinel/policy.bundle
Restart=always
RestartSec=1s
TimeoutStopSec=5s

User=incinerator-sentinel
Group=incinerator-sentinel
DynamicUser=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=strict
UMask=0077
KeyringMode=private
LimitCORE=0
Environment=NO_LOG=1
Environment=NO_TELEMETRY=1

[Install]
WantedBy=multi-user.target
