# Imagen distroless: binario estatico musl, sin shell ni gestor de paquetes.
FROM rust:1.85-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /src
COPY . .

RUN cargo build --release --locked \
      --target x86_64-unknown-linux-musl \
      --no-default-features \
      --features hardened,volatile-audit

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder \
  /src/target/x86_64-unknown-linux-musl/release/incinerator-sentinel \
  /usr/bin/incinerator-sentinel

USER nonroot:nonroot

ENTRYPOINT ["/usr/bin/incinerator-sentinel"]
CMD ["--help"]
